# ─── Calendly (booking capture) ────────────────────────────────────────
# From Calendly > Integrations > Webhooks, when you create the subscription.
# Requires Calendly Standard plan or above.
CALENDLY_SIGNING_SECRET=

# Name of the booking question that captures "What would you like to discuss?"
# Must match the question text exactly as configured on the booking form.
CALENDLY_DISCUSSION_QUESTION="Please share anything that will help prepare for our meeting."

# Personal access token (or OAuth token) from Calendly > Integrations > API.
# The webhook payload itself only carries the invitee's email/name/answers;
# start_time, the manager (event host), and the Teams join_url live on the
# scheduled_event resource, fetched with this token.
CALENDLY_API_TOKEN=

# ─── Groq (summarization — free tier, see README "Why Groq") ──────────
# Sign up at https://console.groq.com (no credit card). Free tier is
# rate-limited (requests/day and tokens/day per account) rather than billed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── Fireflies.ai (meeting capture — Requirement 2) ────────────────────
# Sign up at https://app.fireflies.ai (free plan). Then, separately from
# this config: connect the manager's Microsoft 365 calendar in Fireflies'
# own settings and enable Auto Join, so the Fireflies bot joins every
# Teams meeting on their calendar automatically — that's set up in
# Fireflies' dashboard, not here. Get the API key from Fireflies >
# Integrations > Fireflies API. Get the webhook secret from Fireflies >
# Developer Settings when you register this app's /webhooks/fireflies
# URL there.
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# ─── Microsoft Graph (Teams chat delivery only) ────────────────────────
# Entra ID app registration: needs Application permissions Chat.Create +
# ChatMessage.Send, admin-consented. One-time IT setup, not a running
# cost — but confirm this tenant allows app-only chat messaging (see
# README) before relying on it.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Primary delivery path: 1:1 Teams chat with the manager. Default true —
# every requirement routes through it. Flip to false only if this tenant
# turns out not to support app-only chat messaging.
TEAMS_DM_ENABLED=true

# JSON map of Calendly host/manager email -> Microsoft 365 UPN, only
# needed if they differ.
ATTORNEY_UPN_OVERRIDES={}

# Optional: also broadcast the pre-call brief to a team channel via an
# Incoming Webhook / Workflows connector URL. Never required — leave
# blank to skip it entirely.
TEAMS_CHANNEL_WEBHOOK_URL=

# ─── Scheduling windows ──────────────────────────────────────────────
# Brief consultations starting this many minutes from now (Requirement 1
# asks for ~15 minutes before).
BRIEF_LEAD_MIN_MINUTES=13
BRIEF_LEAD_MAX_MINUTES=17

# Live catch-up (Requirement 3): stop checking a booking after it's been
# running this many minutes, and cap total pushes per meeting.
CATCHUP_ENABLED=true
CATCHUP_MAX_MEETING_MINUTES=90
CATCHUP_MAX_PUSHES=6
CATCHUP_MIN_NEW_CHARS=200

# ─── Leads sheet (Requirement 5) ────────────────────────────────────────
LEADS_SHEET_ENABLED=true
# Locally / on a VM: point this at a synced shared-drive folder
# (OneDrive/Dropbox client, or a mounted network share). On Cloud Run:
# point it at the mounted Cloud Storage bucket instead (see README's
# "Deploying to Cloud Run" section), e.g. /data/leads.xlsx — Cloud Run's
# own disk doesn't survive a restart, so this file needs to live
# somewhere that does. A minimal default template is auto-created here
# if nothing exists yet; swap in the real file at the same path whenever
# it's ready, then run `python -m app.leads_sheet --backfill` to add any
# bookings made before it was in place.
LEADS_SHEET_PATH=leads.xlsx

# ─── Storage / service ────────────────────────────────────────────────
# Bookings/clients/notes live in Firestore, not a local file — see
# app/db.py. GCP_PROJECT_ID is only needed locally; on Cloud Run the
# attached service account already identifies the project.
GCP_PROJECT_ID=

# Shared secret Cloud Scheduler sends when it calls the two internal
# /internal/trigger/* endpoints in place of cron. Only relevant on Cloud
# Run — generate any random 32+ character string, e.g. `openssl rand
# -hex 32`, and use the same value in both places (see README).
INTERNAL_TRIGGER_SECRET=

WEBHOOK_HOST=0.0.0.0
# Local/VM only — Cloud Run sets PORT itself and that always wins (see
# app/config.py).
WEBHOOK_PORT=8000
LOG_LEVEL=INFO
